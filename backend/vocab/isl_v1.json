        "YOU",
        "HELP",
        "ME"
      ],
      "output": "Please help me."
    },
    {
      "pattern": [
        "ME",
        "UNDERSTAND",
        "NO"
      ],
      "output": "I do not understand."
    },
    {
      "pattern": [
        "$NOUN",
        "WHERE"
      ],
      "output": "Where is the {0}?"
    },
    {
      "pattern": [
        "YOU",
        "HOW"
      ],
      "output": "How are you?"
    },
    {
      "pattern": [
        "ME",
        "$ADJ"
      ],
      "output": "I am {1}."
    },
    {
      "pattern": [
        "THANK-YOU"
      ],
      "output": "Thank you."
    },
    {
      "pattern": [
        "HELLO"
      ],
      "output": "Hello."
    },
    {
      "pattern": [
        "SORRY"
      ],
      "output": "Sorry."
    }
