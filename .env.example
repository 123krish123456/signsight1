# Copy to .env. Every SIGNSIGHT_* var overrides backend/config.py — the demo will need
# threshold tuning in the room, and that must not require a code change (PRD §8).

SIGNSIGHT_HOST=127.0.0.1
SIGNSIGHT_PORT=8000

# Features (PRD §4.2) — clients must send this many floats per frame.
SIGNSIGHT_USE_VELOCITY_FEATURES=false
SIGNSIGHT_TARGET_FPS=15

# Segmentation (PRD §4.3). Two thresholds, never one: hysteresis stops IDLE/SIGNING
# flicker at the boundary. Raise ENTER_THRESH if idle fidgeting starts segments.
SIGNSIGHT_ENTER_THRESH=0.08
SIGNSIGHT_EXIT_THRESH=0.04
SIGNSIGHT_MIN_SEGMENT_FRAMES=8
SIGNSIGHT_MAX_SEGMENT_FRAMES=45

# Gating (PRD §4.5). Lower CONFIDENCE_THRESH → more guesses, more errors.
SIGNSIGHT_CONFIDENCE_THRESH=0.75
SIGNSIGHT_REPEAT_COOLDOWN_MS=1200

# Assembly (PRD §4.6/§4.7)
SIGNSIGHT_ASSEMBLY_TIMEOUT_MS=2500
SIGNSIGHT_FINGERSPELL_TIMEOUT_MS=1500

SIGNSIGHT_VOCAB_PACK=backend/vocab/isl_v1.json
