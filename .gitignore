__pycache__/
*.egg-info/
.venv/
.env
.pytest_cache/

node_modules/
dist/

# vendored MediaPipe assets — regenerate with `npm run fetch-assets` (~15 MB)
app/public/wasm/
app/public/models/
extension/vendor/

# data + artefacts
# Recorded clips. Regenerable data, not source: 720 of them would be a few hundred MB
# baked into git history forever, and removing them later means rewriting it. The
# manifest tracks them by path, so the pipeline is unaffected.
ml/data/clips/
# Keras checkpoints are large and regenerable; the ONNX export is what ships, so it
# and the evaluation outputs are versioned — a reader can run the system without
# retraining, and the reported numbers have their artefacts next to them.
ml/models/*.keras
tests/fixtures/parity_frames.json
signsight.db
tsconfig.tsbuildinfo

# training artefacts — models, metadata, cached features, generated reports
ml/data/cache/

# downloaded public datasets — keep out of git, they are gigabytes
ml/data/raw/
